export const storage = {
  get: (key, fallback) => {
    try {
      const v = localStorage.getItem('sp_' + key);
      return v ? JSON.parse(v) : fallback;
    } catch { return fallback; }
  },
  set: (key, val) => {
    try { localStorage.setItem('sp_' + key, JSON.stringify(val)); } catch {}
  },
  remove: (key) => {
    try { localStorage.removeItem('sp_' + key); } catch {}
  },
};
