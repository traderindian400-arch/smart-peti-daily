import React from 'react';
import { useApp } from '../../hooks/useApp';

export default function Toast() {
  const { toast } = useApp();
  if (!toast) return null;
  return (
    <div className={`fixed bottom-20 left-1/2 -translate-x-1/2 z-50 max-w-[90%] px-6 py-3 rounded-xl shadow-lg backdrop-blur-md border ${toast.type === 'error' ? 'border-red-500 text-red-400 bg-red-500/10' : 'border-green-500 text-green-400 bg-green-500/10'}`}>
      {toast.msg}
    </div>
  );
}
