import React, { useState, useEffect, useRef } from 'react';
import { useApp } from '../hooks/useApp';
import { Button } from '../components/ui/Button';
import { Textarea } from '../components/ui/Input';
import ProviderSelector from '../components/ui/ProviderSelector';
import { Card } from '../components/ui/Card';

export default function Chat() {
  const { chatHistory, addChatMessage, callAI, activeProvider, t, showToast } = useApp();
  const [input, setInput] = useState('');
  const [loading, setLoading] = useState(false);
  const endRef = useRef(null);

  useEffect(() => {
    endRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [chatHistory]);

  const sendMessage = async () => {
    if (!input.trim() || loading) return;
    const msg = input.trim();
    setInput('');
    addChatMessage('user', msg);
    setLoading(true);
    try {
      const response = await callAI(msg, activeProvider);
      addChatMessage('assistant', response);
    } catch (err) {
      addChatMessage('assistant', `⚠️ ${err.message || 'Error'}`);
      showToast(err.message, 'error');
    }
    setLoading(false);
  };

  return (
    <div className="p-4 md:p-6 max-w-4xl mx-auto h-[calc(100vh-180px)] flex flex-col">
      <div className="flex items-center justify-between mb-3 flex-wrap gap-2">
        <h1 className="text-xl font-bold flex items-center gap-2">💬 {t('chat')}</h1>
        <ProviderSelector compact />
      </div>

      <div className="flex-1 overflow-y-auto bg-bg-primary border border-border rounded-2xl p-4 space-y-3 scrollbar-hide">
        {chatHistory.length === 0 ? (
          <div className="flex flex-col items-center justify-center h-full text-text-muted">
            <span className="text-5xl mb-4">✨</span>
            <p>Start a conversation with SmartPeti AI</p>
            <p className="text-sm opacity-60">Describe your idea and get intelligent suggestions</p>
          </div>
        ) : (
          chatHistory.map((msg, i) => (
            <div
              key={i}
              className={`max-w-[85%] p-3 rounded-2xl text-sm ${
                msg.role === 'user'
                  ? 'bg-accent text-white self-end rounded-br-none'
                  : 'bg-bg-card border border-border self-start rounded-bl-none'
              }`}
              dangerouslySetInnerHTML={{ __html: msg.content.replace(/\n/g, '<br/>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>') }}
            />
          ))
        )}
        {loading && (
          <div className="self-start bg-bg-card border border-border rounded-2xl rounded-bl-none p-3 flex items-center gap-2">
            <span className="w-2 h-2 bg-accent rounded-full animate-pulse" />
            <span className="w-2 h-2 bg-accent rounded-full animate-pulse delay-150" />
            <span className="w-2 h-2 bg-accent rounded-full animate-pulse delay-300" />
            <span className="text-sm text-text-muted ml-1">{t('generating')}</span>
          </div>
        )}
        <div ref={endRef} />
      </div>

      <div className="flex gap-2 mt-3">
        <Textarea
          className="flex-1 !min-h-[44px] !max-h-[120px]"
          placeholder={t('typeMessage')}
          value={input}
          onChange={(e) => setInput(e.target.value)}
          onKeyDown={(e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault();
              sendMessage(); } }}
          rows={1}
        />
        <Button onClick={sendMessage} disabled={loading || !input.trim()} className="!p-3 !rounded-full !w-12 !h-12 flex-shrink-0">
          <span className="text-lg">➤</span>
        </Button>
      </div>
    </div>
  );
}
