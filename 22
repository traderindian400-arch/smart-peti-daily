import React from 'react';
import { NavLink } from 'react-router-dom';
import { useApp } from '../../hooks/useApp';

const items = [
  { to: '/', icon: '🏠', label: 'home' },
  { to: '/chat', icon: '💬', label: 'chat' },
  { to: '/app', icon: '📱', label: 'appBuilder' },
  { to: '/website', icon: '🌐', label: 'websiteBuilder' },
  { to: '/ebook', icon: '📘', label: 'ebook' },
  { to: '/game', icon: '🎮', label: 'gameBuilder' },
  { to: '/projects', icon: '📂', label: 'projects' },
  { to: '/settings', icon: '⚙️', label: 'settings' },
];

export default function BottomNav() {
  const { t } = useApp();
  return (
    <nav className="md:hidden fixed bottom-0 left-0 right-0 bg-bg-secondary border-t border-border flex justify-around items-center px-2 py-1 z-50 backdrop-blur-lg">
      {items.slice(0, 6).map(item => (
        <NavLink
          key={item.to}
          to={item.to}
          className={({ isActive }) =>
            `flex flex-col items-center gap-0.5 py-1 px-2 rounded-lg text-[10px] font-medium transition ${
              isActive ? 'text-accent' : 'text-text-muted'
            }`
          }
        >
          <span className="text-lg">{item.icon}</span>
          <span>{t(item.label).slice(0, 10)}</span>
        </NavLink>
      ))}
      <NavLink
        to="/settings"
        className={({ isActive }) =>
          `flex flex-col items-center gap-0.5 py-1 px-2 rounded-lg text-[10px] font-medium transition ${
            isActive ? 'text-accent' : 'text-text-muted'
          }`
        }
      >
        <span className="text-lg">⚙️</span>
        <span>{t('settings')}</span>
      </NavLink>
    </nav>
  );
}
